{
  "name": "focused-search-mcp-node",
  "version": "0.1.0",
  "description": "A self-hosted MCP search server and web gateway for AI and remote MCP tools.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "focused-search-mcp-node": "dist/server.js"
  },
  "files": [
    "dist",
    "public",
    "start.js",
    "LICENSE",
    "README.md",
    "README.zh-TW.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm run build && npm test",
    "dev": "tsx src/server.ts",
    "dev:web": "tsx src/web-server.ts",
    "lint": "eslint .",
    "start": "node dist/server.js",
    "start:web": "node start.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "tsx": "^4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "fast-uri": "3.1.4"
  }
}
